{
  "base_url": "http://localhost:8000",
  "routes": [
    {
      "path": "/api/auth/register",
      "method": "POST",
      "summary": "Register a new user",
      "description": "Create a new user account with full name, email, and password.",
      "auth_required": false,
      "request_body": {
        "type": "json",
        "fields": {
          "full_name": {
            "type": "string",
            "required": true,
            "description": "Full name of the user"
          },
          "email": {
            "type": "string",
            "format": "email",
            "required": true,
            "description": "Unique email address for login"
          },
          "password": {
            "type": "string",
            "required": true,
            "description": "Secure password (minimum length: 8 characters)"
          }
        }
      },
      "responses": {
        "201": {
          "description": "Account created successfully",
          "body": {
            "message": "Account created successfully"
          }
        },
        "400": {
          "description": "Validation error (invalid email format or short password)"
        },
        "409": {
          "description": "Conflict (email address is already registered)"
        }
      }
    },
    {
      "path": "/api/auth/login",
      "method": "POST",
      "summary": "User Login",
      "description": "Authenticate user credentials and retrieve a JWT token.",
      "auth_required": false,
      "request_body": {
        "type": "json",
        "fields": {
          "email": {
            "type": "string",
            "format": "email",
            "required": true
          },
          "password": {
            "type": "string",
            "required": true
          }
        }
      },
      "responses": {
        "200": {
          "description": "Authentication successful",
          "body": {
            "access_token": "JWT access token string",
            "token_type": "bearer",
            "user": {
              "id": "uuid",
              "full_name": "string",
              "email": "string",
              "created_at": "datetime"
            }
          }
        },
        "401": {
          "description": "Unauthorized (incorrect email or password)"
        }
      }
    },
    {
      "path": "/api/auth/me",
      "method": "GET",
      "summary": "Get current user profile",
      "description": "Retrieve active session metadata and user details.",
      "auth_required": true,
      "headers": {
        "Authorization": "Bearer <access_token>"
      },
      "responses": {
        "200": {
          "description": "Successfully retrieved user details",
          "body": {
            "id": "uuid",
            "full_name": "string",
            "email": "string",
            "created_at": "datetime"
          }
        },
        "401": {
          "description": "Not authenticated (missing or invalid token)"
        }
      }
    },
    {
      "path": "/api/documents/upload",
      "method": "POST",
      "summary": "Upload a document",
      "description": "Upload a PDF, PNG, JPG, or JPEG file (up to 10MB) and save its metadata.",
      "auth_required": true,
      "headers": {
        "Authorization": "Bearer <access_token>"
      },
      "request_body": {
        "type": "multipart/form-data",
        "fields": {
          "file": {
            "type": "file",
            "required": true,
            "description": "The file binary to upload (PDF, PNG, JPG, JPEG). Max size: 10MB"
          },
          "title": {
            "type": "string",
            "required": true,
            "description": "Title of the document (1 to 255 characters)"
          },
          "document_type": {
            "type": "string",
            "required": true,
            "enum": ["PASSPORT", "NATIONAL_ID", "BIRTH_CERTIFICATE", "ACADEMIC_CERTIFICATE", "PROPERTY_DOCUMENT", "WILL", "OTHER"],
            "description": "Category type of the document"
          },
          "description": {
            "type": "string",
            "required": false,
            "description": "Optional description text"
          },
          "expiry_date": {
            "type": "string",
            "format": "date-time",
            "required": false,
            "description": "Optional ISO-8601 expiration date"
          }
        }
      },
      "responses": {
        "201": {
          "description": "Document created and uploaded successfully",
          "body": {
            "id": "uuid",
            "owner_id": "uuid",
            "title": "string",
            "document_type": "string",
            "description": "string|null",
            "file_name": "string",
            "file_path": "string",
            "file_size": 1024,
            "mime_type": "string",
            "expiry_date": "string|null",
            "uploaded_at": "datetime",
            "created_at": "datetime",
            "updated_at": "datetime|null"
          }
        },
        "400": {
          "description": "Validation error (invalid file type or oversized file)"
        },
        "401": {
          "description": "Not authenticated"
        }
      }
    },
    {
      "path": "/api/documents",
      "method": "GET",
      "summary": "Get user's documents list",
      "description": "Retrieve paginated documents list for the current authenticated user with title search.",
      "auth_required": true,
      "headers": {
        "Authorization": "Bearer <access_token>"
      },
      "query_parameters": {
        "page": {
          "type": "integer",
          "default": 1,
          "required": false,
          "description": "Page number (min: 1)"
        },
        "limit": {
          "type": "integer",
          "default": 10,
          "required": false,
          "description": "Items per page (1 to 100)"
        },
        "search": {
          "type": "string",
          "required": false,
          "description": "Case-insensitive title search term"
        }
      },
      "responses": {
        "200": {
          "description": "Paginated list retrieved successfully",
          "body": {
            "items": [
              {
                "id": "uuid",
                "owner_id": "uuid",
                "title": "string",
                "document_type": "string",
                "description": "string|null",
                "file_name": "string",
                "file_path": "string",
                "file_size": 1234,
                "mime_type": "string",
                "expiry_date": "string|null",
                "uploaded_at": "datetime",
                "created_at": "datetime",
                "updated_at": "datetime|null"
              }
            ],
            "total": 1,
            "page": 1,
            "limit": 10
          }
        },
        "401": {
          "description": "Not authenticated"
        }
      }
    },
    {
      "path": "/api/documents/{id}",
      "method": "GET",
      "summary": "Get document details",
      "description": "Retrieve full metadata of a specific document owned by the user.",
      "auth_required": true,
      "headers": {
        "Authorization": "Bearer <access_token>"
      },
      "path_parameters": {
        "id": {
          "type": "uuid",
          "required": true,
          "description": "Unique identifier of the document"
        }
      },
      "responses": {
        "200": {
          "description": "Metadata details retrieved successfully",
          "body": {
            "id": "uuid",
            "owner_id": "uuid",
            "title": "string",
            "document_type": "string",
            "description": "string|null",
            "file_name": "string",
            "file_path": "string",
            "file_size": 1234,
            "mime_type": "string",
            "expiry_date": "string|null",
            "uploaded_at": "datetime",
            "created_at": "datetime",
            "updated_at": "datetime|null"
          }
        },
        "401": {
          "description": "Not authenticated"
        },
        "403": {
          "description": "Forbidden (attempting to access another user's document)"
        },
        "404": {
          "description": "Document not found"
        }
      }
    },
    {
      "path": "/api/documents/{id}/download",
      "method": "GET",
      "summary": "Generate temporary download URL",
      "description": "Retrieve a secure, temporary (1-hour expiry) signed URL to download/view the document from storage.",
      "auth_required": true,
      "headers": {
        "Authorization": "Bearer <access_token>"
      },
      "path_parameters": {
        "id": {
          "type": "uuid",
          "required": true,
          "description": "Unique identifier of the document"
        }
      },
      "responses": {
        "200": {
          "description": "Signed URL generated successfully",
          "body": {
            "download_url": "https://crzevbgduvewwpwyaqfa.supabase.co/storage/v1/object/sign/vaultpass-documents/..."
          }
        },
        "401": {
          "description": "Not authenticated"
        },
        "403": {
          "description": "Forbidden (attempting to access another user's document)"
        },
        "404": {
          "description": "Document not found"
        }
      }
    },
    {
      "path": "/api/documents/{id}",
      "method": "PUT",
      "summary": "Update document metadata",
      "description": "Modify title, description, document type, or expiration date of an existing document.",
      "auth_required": true,
      "headers": {
        "Authorization": "Bearer <access_token>"
      },
      "path_parameters": {
        "id": {
          "type": "uuid",
          "required": true,
          "description": "Unique identifier of the document"
        }
      },
      "request_body": {
        "type": "json",
        "fields": {
          "title": {
            "type": "string",
            "required": false,
            "description": "Updated title (1 to 255 characters)"
          },
          "description": {
            "type": "string",
            "required": false,
            "description": "Updated description text"
          },
          "expiry_date": {
            "type": "string",
            "format": "date-time",
            "required": false,
            "description": "Updated ISO-8601 expiration date"
          },
          "document_type": {
            "type": "string",
            "enum": ["PASSPORT", "NATIONAL_ID", "BIRTH_CERTIFICATE", "ACADEMIC_CERTIFICATE", "PROPERTY_DOCUMENT", "WILL", "OTHER"],
            "required": false,
            "description": "Updated category type of the document"
          }
        }
      },
      "responses": {
        "200": {
          "description": "Metadata updated successfully",
          "body": {
            "id": "uuid",
            "owner_id": "uuid",
            "title": "string",
            "document_type": "string",
            "description": "string|null",
            "file_name": "string",
            "file_path": "string",
            "file_size": 1234,
            "mime_type": "string",
            "expiry_date": "string|null",
            "uploaded_at": "datetime",
            "created_at": "datetime",
            "updated_at": "datetime"
          }
        },
        "401": {
          "description": "Not authenticated"
        },
        "403": {
          "description": "Forbidden (attempting to update another user's document)"
        },
        "404": {
          "description": "Document not found"
        }
      }
    },
    {
      "path": "/api/documents/{id}",
      "method": "DELETE",
      "summary": "Delete a document",
      "description": "Delete the document record from the database and remove the associated file from Supabase Storage.",
      "auth_required": true,
      "headers": {
        "Authorization": "Bearer <access_token>"
      },
      "path_parameters": {
        "id": {
          "type": "uuid",
          "required": true,
          "description": "Unique identifier of the document"
        }
      },
      "responses": {
        "200": {
          "description": "Document deleted successfully",
          "body": {
            "message": "Document deleted successfully"
          }
        },
        "401": {
          "description": "Not authenticated"
        },
        "403": {
          "description": "Forbidden (attempting to delete another user's document)"
        },
        "404": {
          "description": "Document not found"
        }
      }
    },
    {
      "path": "/health",
      "method": "GET",
      "summary": "Health check",
      "description": "Determine if the server is up and responsive.",
      "auth_required": false,
      "responses": {
        "200": {
          "description": "Server is healthy",
          "body": {
            "status": "healthy"
          }
        }
      }
    }
  ]
}
